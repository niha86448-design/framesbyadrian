# Copy this file to .env.local and fill in real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Google Drive API key (server-only — powers the photo/video galleries)
GOOGLE_DRIVE_API_KEY=

# Resend API key for the contact form (https://resend.com/api-keys)
RESEND_API_KEY=

# Optional contact-form overrides (defaults shown in comments):
# CONTACT_TO_EMAIL=framesbyaj@gmail.com
# Before verifying a domain in Resend, use the onboarding sender:
# CONTACT_FROM_EMAIL=FramesByAdrian <onboarding@resend.dev>
# After verifying framesbyadrian.com in Resend:
# CONTACT_FROM_EMAIL=FramesByAdrian <hello@framesbyadrian.com>

# Public site URL — used for SEO/social image resolution
# NEXT_PUBLIC_SITE_URL=https://framesbyadrian.com
